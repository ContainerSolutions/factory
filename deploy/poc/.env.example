# The PoC dispatcher's environment (deploy/poc/README.md §Secrets). Names and comments only.
#
#   cp deploy/poc/.env.example deploy/poc/.env && chmod 600 deploy/poc/.env
#
# then fill deploy/poc/.env in an editor. It is gitignored; run.sh refuses it unless only you
# can read it (0600), and never prints a value. run.sh sources it with bash, so a value with
# spaces or newlines (a PEM) must be double-quoted, or read from a file kept outside the repo:
#   FACTORY_SECRET_CCF_FACTORY_APP_PRIVATE_KEY="$(cat /path/outside/the/repo/ccf-factory.pem)"
#
# A catalog secretRef {name, key} is read from FACTORY_SECRET_<NAME>_<KEY>: upper-cased, every
# character but A-Z and 0-9 turned into _. cmd/factory/deploykit_test.go checks that every
# secretRef of catalog/ has its line here.

# ---- factory serve --------------------------------------------------------------------------

# The public base URL: the ngrok domain, https://<name>.ngrok-free.dev (no trailing slash).
# Config, not a secret: it lives here only so the public repo doesn't carry it.
FACTORY_PUBLIC_URL=

# The ccf-factory GitHub App's client ID and one of its client secrets (App settings, General).
# Only the UI login uses them (agents register with an enrollment token, not an OAuth login).
FACTORY_OAUTH_CLIENT_ID=
FACTORY_OAUTH_CLIENT_SECRET=

# Signs the UI session cookies. openssl rand -hex 32
FACTORY_SESSION_KEY=

# The CLI admin token: factory dispatch and the API with a bearer token. openssl rand -hex 32
FACTORY_CLI_TOKEN=

# ---- catalog secretRefs ---------------------------------------------------------------------

# catalog/providers/github-public.yaml spec.github.webhook.secretRef: ccf-factory's webhook
# secret, the same value as in the App's settings. openssl rand -hex 32
FACTORY_SECRET_GITHUB_PUBLIC_WEBHOOK_SECRET=

# catalog/providers/github-public.yaml identities.author.privateKeyRef: ccf-factory's private
# key (PEM, the whole file).
FACTORY_SECRET_CCF_FACTORY_APP_PRIVATE_KEY=

# catalog/providers/github-public.yaml identities.reviewer.privateKeyRef: ccf-factory-reviewer's
# private key (PEM, the whole file).
FACTORY_SECRET_CCF_FACTORY_REVIEWER_APP_PRIVATE_KEY=

# catalog/pools/local.yaml admission.tokenRef: the local Pool's join token, handed to agent
# owners out of band. openssl rand -hex 32
FACTORY_SECRET_LOCAL_POOL_JOIN_TOKEN=

# ---- the catalog (README §Catalog): set FACTORY_CATALOG_REPO or FACTORY_CATALOG_DIR ---------
# run.sh refuses to start without one of them, so both stay commented out here.

# The git repository the catalog is read from (factory serve --catalog-repo). There is no
# default: this repository's catalog/ is the reference to copy, not one to run. CCF's:
# FACTORY_CATALOG_REPO=https://github.com/compliance-framework/factory-catalog

# The branch, tag or commit of FACTORY_CATALOG_REPO (factory serve --catalog-ref). Default: main.
# FACTORY_CATALOG_REF=

# The catalog's directory in FACTORY_CATALOG_REPO (factory serve --catalog-path). Default:
# catalog.
# FACTORY_CATALOG_PATH=

# Load the catalog from this local directory (factory serve --catalog-dir) instead of git,
# an absolute path. Set, it wins over FACTORY_CATALOG_REPO, _REF and _PATH.
# FACTORY_CATALOG_DIR=

# The GitHub App that reads a private catalog repository (factory serve --catalog-app-id), with
# the key FACTORY_SECRET_CCF_FACTORY_APP_PRIVATE_KEY (--catalog-app-key-ref
# ccf-factory-app/private-key). Unset: the catalog is read anonymously. Ignored with
# FACTORY_CATALOG_DIR.
# FACTORY_CATALOG_APP_ID=

# ---- run.sh settings (optional) -------------------------------------------------------------

# The public listener (factory serve --addr), what ngrok forwards to. Default: 127.0.0.1:8800.
# FACTORY_ADDR=

# Where the dispatcher keeps its state (factory serve --state-dir, README §State), so tasks,
# runs, transcripts and agent registrations survive a restart. Created 0700 if missing; it
# must stay private to you. Default: ~/.factory/state.
# FACTORY_STATE_DIR=

# How long a review waits for another agent before the agent that wrote the PR may take it
# on the same harness (factory serve --anti-affinity-wait). 0 turns anti-affinity off.
# Default: 10m.
# FACTORY_ANTI_AFFINITY_WAIT=
