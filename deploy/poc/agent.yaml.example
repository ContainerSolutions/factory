# factory-agent's config (deploy/poc/README.md §Agent onboarding). Copy it to
# ~/.config/factory-agent/agent.yaml (the default --config of supervise and probe) and chmod 600
# it: the agent refuses a config that group or others can write. It is decoded strictly: an
# unknown or misspelt key is an error. A leading ~/ in paths is the running user's home.
# cmd/factory-agent/deploykit_test.go parses this file with the real loader.

# The dispatcher's base URL. https off the dispatcher's machine (the tunnel); plain http only on
# a loopback host, e.g. http://127.0.0.1:8800 for an agent on the dispatcher's own machine.
dispatcher: https://your-name.ngrok-free.dev

# The registered Pool to join (catalog/pools/local.yaml).
pool: local

# A file holding the Pool's join token (one line), given by the dispatcher operator out of
# band. It must be absolute (or start with ~/) and readable by you only (chmod 600).
joinTokenFile: ~/.config/factory-agent/join-token

# Optional: names the agent agt_<owner login>-<host>. Default: this machine's short host name,
# lower-cased.
# host: mymac

# Optional: the GitHub the owner's device-flow login runs against. Default https://github.com.
# githubURL: https://github.com

# Optional: capability labels to advertise, as configured (a TaskSpec's requires.labels). No
# catalog TaskSpec requires one: release-docs and docs-review-verify declare their environment,
# which a VM workspace brings up.
# labels: [fast-disk]

# Optional: where per-task workspaces go. Default ~/.factory-agent/work.
# workRoot: ~/.factory-agent/work

# One entry per harness this machine offers (at least one), offered when its model login is
# stored (`factory-agent login`, README §Agent onboarding). Each still names a config dir;
# models are what your plan allows, default one of them; efforts from minimal, low, medium,
# high, max.
harnesses:
  codex:
    home: ~/.factory-agent/codex-home          # codex's dedicated CODEX_HOME
    # Change the model: put <a gpt-5* or gpt-6* model your codex sign-in offers> (see /model
    # in codex). The TaskSpecs match a glob, and a model the sign-in doesn't offer fails the run.
    models: [gpt-6.1-sol]                      # release-docs, implement, plan-epic and merge ask gpt-5* or gpt-6*
    efforts: [low, medium, high]               # merge asks low, implement medium, the others high
    default: gpt-6.1-sol
  claude-code:
    configDir: ~/.factory-agent/claude         # claude's dedicated CLAUDE_CONFIG_DIR
    models: [claude-sonnet-5-5, claude-opus-5-5]   # docs-review asks claude-{sonnet,opus}-5-* at high
    efforts: [low, medium, high, max]
    default: claude-sonnet-5-5

# Your consent: what this agent may take. Either unlimited: true (only maxConcurrent then
# applies), or a list of queues plus optional limits. SIGHUP to supervise re-reads this block.
lending:
  unlimited: true
  # maxConcurrent: 1                # tasks at once; default 1
  # Instead of unlimited:
  # queues: [poc]
  # ruleSets: [dev-release-docs, dev-docs-epic]
  # harnesses: [codex, claude-code]
  # maxRunsPerDay: 10
  # maxTokensPerDay: 2000000
  # hours: "Mon-Fri 08:00-20:00 Europe/Lisbon"   # [days] HH:MM-HH:MM [zone]; default zone UTC

# The VM workspaces (P1): `factory-agent host check|init` and `factory-agent supervise` read this
# block.
# workspace:
#   driver: tart                    # tart | kata; default tart on macOS, kata on Linux
#   size: { cpus: 6, memory: 8Gi, disk: 60Gi }
#   gatewayPort: 3128               # the only port workspaces reach on the host (pf, or kata's nft)
#   warm: { images: [postgres:17.5], kindImages: [] }
#
# A Linux host (README §A Linux workspace host): Kata microVMs, several at once. supervise caps
# lending.maxConcurrent at (physical memory - 4 GiB) / size.memory and at 63, e.g. with
#   lending: { unlimited: true, maxConcurrent: 3 }
# workspace:
#   driver: kata
#   size: { cpus: 6, memory: 8Gi, disk: 60Gi }   # each workspace's; disk is an empty Docker disk's
#   warm: { images: [postgres:17.5] }            # host init loads these into the warm Docker disk
