#!/bin/sh
# dockerd's and containerd's storage on the workspace's own disk (workspace-kata.md, "The
# image"): the rootfs is virtio-fs, where overlayfs doesn't work, so kata-helper create mounts a
# per-workspace file at $IMG (sparse and empty, or a copy of the warm disk). This makes it ext4
# unless it already is, loop-mounts it at $DISK and bind-mounts its docker and containerd
# directories: Docker 29 keeps images in containerd's store, so both must be on the disk.
# privileged-without-host-devices leaves /dev without loop nodes, so they are made first.
# Without the file it fails, and docker and containerd (which require this unit) don't start.
set -eu
IMG=/var/lib/factory/docker.img
DISK=/var/lib/factory/disk

log() { echo "factory-docker-storage: $*"; }

[ -e /dev/loop-control ] || mknod -m 0660 /dev/loop-control c 10 237
for i in 0 1 2 3 4 5 6 7; do
	[ -e "/dev/loop$i" ] || mknod -m 0660 "/dev/loop$i" b 7 "$i"
done

if [ ! -f "$IMG" ]; then
	log "$IMG is missing: the workspace has no disk"
	exit 1
fi
if [ "$(blkid -p -o value -s TYPE "$IMG" 2>/dev/null || true)" != ext4 ]; then
	log "mkfs.ext4 $IMG"
	mkfs.ext4 -q -F -L factory-docker -E lazy_itable_init=1,lazy_journal_init=1 "$IMG"
fi
mkdir -p "$DISK" /var/lib/docker /var/lib/containerd
mountpoint -q "$DISK" || mount -o loop,noatime "$IMG" "$DISK"
mkdir -p "$DISK/docker" "$DISK/containerd"
mountpoint -q /var/lib/docker || mount --bind "$DISK/docker" /var/lib/docker
mountpoint -q /var/lib/containerd || mount --bind "$DISK/containerd" /var/lib/containerd
log "mounted $(findmnt -no SOURCE,FSTYPE "$DISK") at $DISK"
