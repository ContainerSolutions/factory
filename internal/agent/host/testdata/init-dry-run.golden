plan:
  statedir  create $HOME/Library/Application Support/factory-agent with mode 0700
  tart      download https://github.com/cirruslabs/tart/releases/download/2.41.1/tart.tar.gz and check its sha256
  tart      extract tart.app into $HOME/Library/Application Support/factory-agent/tart
  tart      verify its signature with codesign: an Apple-issued certificate for team 9M2P8L4D89
  softnet   download https://github.com/cirruslabs/softnet/releases/download/0.24.1/softnet.tar.gz, check its sha256 and the binary's
  softnet   install it SUID root at $ROOT/usr/local/libexec/factory-agent/softnet (sudo)
  pf        render the anchor (gateway port 3128, bridge100 to bridge163) and the LaunchDaemon into the sudo script
  pf        install them, append anchor "com.compliance-framework.factory" to /etc/pf.conf (backup /etc/pf.conf.factory-backup) and load the LaunchDaemon (sudo)
sudo script (one sudo prompt):
#!/bin/sh
# factory-agent host init: the root actions, run once with sudo.
set -eu
/usr/bin/install -d -o root -g wheel -m 0755 $ROOT/usr/local/libexec/factory-agent
/usr/bin/install -o root -g wheel -m 0700 $STAGE/softnet $ROOT/usr/local/libexec/factory-agent/softnet.new
printf '%s  %s\n' e5e35d61a6dd7e35a3134732e766c897b7cb6f097080ff00e1e75adeab0471c7 $ROOT/usr/local/libexec/factory-agent/softnet.new | /usr/bin/shasum -a 256 -c -
/bin/chmod 4755 $ROOT/usr/local/libexec/factory-agent/softnet.new
/bin/mv -f $ROOT/usr/local/libexec/factory-agent/softnet.new $ROOT/usr/local/libexec/factory-agent/softnet
T=$(/usr/bin/mktemp -d /tmp/factory-agent-root.XXXXXX)
trap '/bin/rm -rf "$T"' EXIT
/bin/cat > "$T/pf.anchor" <<'FACTORY_AGENT_EOF'
# com.compliance-framework.factory: factory workspaces reach only their gateway on the Mac.
# macOS pf has no interface groups, so the rules name bridge100 to bridge163: Softnet and vmnet
# number their bridges from bridge100 up, one per running VM.
bridges = "{ bridge100 bridge101 bridge102 bridge103 bridge104 bridge105 bridge106 bridge107 \
  bridge108 bridge109 bridge110 bridge111 bridge112 bridge113 bridge114 bridge115 \
  bridge116 bridge117 bridge118 bridge119 bridge120 bridge121 bridge122 bridge123 \
  bridge124 bridge125 bridge126 bridge127 bridge128 bridge129 bridge130 bridge131 \
  bridge132 bridge133 bridge134 bridge135 bridge136 bridge137 bridge138 bridge139 \
  bridge140 bridge141 bridge142 bridge143 bridge144 bridge145 bridge146 bridge147 \
  bridge148 bridge149 bridge150 bridge151 bridge152 bridge153 bridge154 bridge155 \
  bridge156 bridge157 bridge158 bridge159 bridge160 bridge161 bridge162 bridge163 }"
pass in quick on $bridges proto tcp from any to (self) port 3128
pass in quick on $bridges proto udp from any to (self) port { 53, 67 }
block drop in quick on $bridges proto { tcp, udp } from any to (self)
FACTORY_AGENT_EOF
/bin/cat > "$T/pf.plist" <<'FACTORY_AGENT_EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.compliance-framework.factory.pf</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/sbin/pfctl -E -f $ROOT/etc/pf.conf &amp;&amp; /sbin/pfctl -a com.compliance-framework.factory -f $ROOT/etc/pf.anchors/com.compliance-framework.factory</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
FACTORY_AGENT_EOF
/sbin/pfctl -n -a com.compliance-framework.factory -f "$T/pf.anchor"
/usr/bin/install -o root -g wheel -m 0644 "$T/pf.anchor" $ROOT/etc/pf.anchors/com.compliance-framework.factory
/usr/bin/install -o root -g wheel -m 0644 "$T/pf.plist" $ROOT/Library/LaunchDaemons/com.compliance-framework.factory.pf.plist
if ! /usr/bin/grep -qxF 'anchor "com.compliance-framework.factory"' $ROOT/etc/pf.conf; then
  [ -e $ROOT/etc/pf.conf.factory-backup ] || /bin/cp -p $ROOT/etc/pf.conf $ROOT/etc/pf.conf.factory-backup
  [ -z "$(/usr/bin/tail -c 1 $ROOT/etc/pf.conf)" ] || echo >> $ROOT/etc/pf.conf
  echo 'anchor "com.compliance-framework.factory"' >> $ROOT/etc/pf.conf
fi
/sbin/pfctl -E -f $ROOT/etc/pf.conf
/sbin/pfctl -a com.compliance-framework.factory -f $ROOT/etc/pf.anchors/com.compliance-framework.factory
/bin/launchctl bootout system/com.compliance-framework.factory.pf 2>/dev/null || true
/bin/launchctl bootstrap system $ROOT/Library/LaunchDaemons/com.compliance-framework.factory.pf.plist
