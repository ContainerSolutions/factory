tart clone factory-agent-base-0.1.0 factory-agent-base-0.1.0.building
tart run factory-agent-base-0.1.0.building --no-graphics &
tart exec factory-agent-base-0.1.0.building true
tart exec -i factory-agent-base-0.1.0.building sudo tar -xf - -C /usr/local/bin <stdin
tart exec factory-agent-base-0.1.0.building sha256sum /usr/local/bin/factory-agent
tart exec factory-agent-base-0.1.0.building sudo cloud-init clean --logs
tart exec factory-agent-base-0.1.0.building sudo truncate -s 0 /etc/machine-id
tart exec factory-agent-base-0.1.0.building sudo shutdown -h now
tart list --format json
tart list --format json
