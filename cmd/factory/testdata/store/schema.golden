Agent .kind string
Agent .metadata object
Agent .metadata.name string
Agent .metadata.labels map
Agent .metadata.labels{} string
Agent .metadata.resourceVersion string
Agent .metadata.createdAt time.Time
Agent .spec object
Agent .spec.pool string
