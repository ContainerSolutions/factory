{
  "name": "factory-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest --watch=false",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:check": "node scripts/gen-api.mjs --check",
    "reviewable": "run-s gen:api:check format:check lint test:unit build"
  },
  "engines": {
    "npm": "^10.1",
    "node": "^20.19"
  },
  "dependencies": {
    "@primevue/icons": "4.4.0",
    "openapi-fetch": "0.17.0",
    "pinia": "2.3.1",
    "primevue": "4.4.0",
    "tailwind-merge": "3.3.1",
    "vue": "3.5.43",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.1.14",
    "@tsconfig/node20": "20.1.6",
    "@types/js-yaml": "4.0.9",
    "@types/jsdom": "21.1.7",
    "@types/node": "20.19.19",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/eslint-plugin": "1.1.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.7.0",
    "eslint": "9.36.0",
    "eslint-plugin-vue": "9.33.0",
    "js-yaml": "4.3.2",
    "jsdom": "25.0.1",
    "msw": "2.15.0",
    "npm-run-all2": "7.0.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "5.6.3",
    "vite": "6.4.4",
    "vitest": "4.1.11",
    "vue-tsc": "2.2.12"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always"
  },
  "overrides": {
    "vite": "$vite"
  }
}
